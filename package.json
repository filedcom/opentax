{
  "name": "@filed/tax-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "module": "./mod.ts",
  "dependencies": {
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@std/cli": "npm:@jsr/std__cli@1.0.24",
    "@std/csv": "npm:@jsr/std__csv@1.0.6",
    "fast-xml-parser": "4.5.3",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "dprint": "0.50.2",
    "oxlint": "1.88.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "tax": "bun cli/main.ts",
    "test": "bun scripts/testing/run.ts full",
    "test:unit": "bun scripts/testing/run.ts unit",
    "test:forms": "bun scripts/testing/run.ts forms",
    "test:harness": "bun scripts/testing/run.ts harness",
    "test:preflight": "bun scripts/testing/run.ts preflight",
    "check:structure": "bun scripts/testing/structure.ts",
    "check:cases": "bun benchmark/check_cases.ts",
    "check:oracle": "bun scripts/testing/oracle.ts",
    "check:sandbox": "bun scripts/testing/sandbox.ts",
    "check:mef": "bun scripts/testing/mef.ts",
    "check:cli": "bun scripts/testing/cli.ts",
    "check:ats": "bun scripts/testing/ats.ts",
    "check:irs": "bun scripts/testing/irs.ts",
    "ats:stage": "bun forms/f1040/e2e/ats/ty2025-stage.ts",
    "typecheck": "tsc --project tsconfig.json",
    "bench": "bun benchmark/run_benchmark.ts",
    "bench:cached": "bun scripts/testing/bench-cached.ts",
    "verify:changed": "bun scripts/testing/changed.ts",
    "compile": "bun build cli/main.ts --compile --outfile opentax",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint --ignore-pattern '.state/**' --ignore-pattern 'scripts/parity/golden/**'"
  }
}
