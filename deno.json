{
  "name": "@filed/tax-engine",
  "version": "0.0.1",
  "exports": "./mod.ts",
  "imports": {
    "zod": "npm:zod@^3.24",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "fflate": "npm:fflate@0.8.2",
    "fast-xml-parser": "npm:fast-xml-parser@4.5.3",
    "@std/assert": "jsr:@std/assert",
    "@std/fs": "jsr:@std/fs",
    "@std/cli": "jsr:@std/cli",
    "@std/path": "jsr:@std/path"
  },
  "tasks": {
    "tax": "deno run --allow-read --allow-write --allow-net=www.irs.gov cli/main.ts",
    "test": "deno test --allow-read --allow-write --allow-run=xmllint,deno,pdftotext,pdftoppm --allow-env=FORM8621_EDUCATION_EVIDENCE_DIR,FORM8621_BUSINESS_EVIDENCE_DIR,FORM8621_ADOPTION_EVIDENCE_DIR,OPENTAX_SCHEDULE1A_FEIE_REVIEW_PDF,SCHEDULE1A_2555_REVIEW_PDF,SCHEDULE1A_2555_VEHICLE_REVIEW_PDF --allow-net=www.irs.gov",
    "bench": "deno run --allow-read --allow-write --allow-run benchmark/run_benchmark.ts",
    "compile": "deno compile --allow-read --allow-write --allow-net=www.irs.gov --output opentax cli/main.ts"
  }
}
