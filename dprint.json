{
  "typescript": {
    "deno": true
  },
  "json": {
    "deno": true
  },
  "markdown": {
    "deno": true,
    "textWrap": "maintain"
  },
  "excludes": [
    "node_modules",
    ".state",
    "bun.lock",
    "docs/build"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm"
  ]
}
